---
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import VramCalc from '../components/VramCalc.astro';
import Faq from '../components/Faq.astro';
import productos from '../data/productos.json';
import categorias from '../data/categorias.json';
import { SITE } from '../lib/site.js';
import { notaIA } from '../lib/calc.js';
import { faqPage, itemList } from '../lib/schema.js';

const total = (p) => notaIA(p, productos);
const destacados = [...productos].sort((a, b) => total(b) - total(a)).slice(0, 6);
const codigos = { 'graficas-para-ia': 'GPU-01', 'graficas-ia-baratas': 'GPU-02', 'graficas-para-stable-diffusion': 'IMG-03', 'mini-pc-ia': 'MINI-04', 'mac-para-ia': 'MAC-05', 'edge-ai': 'EDGE-06' };
const faq = [
  ['¿Qué es lo más importante en una gráfica para IA?', 'La VRAM: decide qué modelos caben. Después, el ancho de banda de memoria, que marca cuántos tokens por segundo genera. Los FPS en juegos no dicen nada sobre IA.'],
  ['¿Por qué no mostráis precios?', 'Porque en Amazon cambian varias veces al día. Preferimos llevarte al precio real en Amazon antes que enseñarte uno viejo.'],
  ['¿Cómo gana dinero ' + SITE.nombre + '?', 'Con enlaces de afiliado de Amazon: si compras desde ellos, Amazon nos paga una pequeña comisión sin que tú pagues más. No cobramos a marcas por aparecer.'],
  ['¿De dónde salen los tokens por segundo?', 'Son una estimación propia a partir del ancho de banda y el tamaño del modelo, no un benchmark. La fórmula está publicada en "Cómo elegimos".'],
];
---
<Base
  title={`${SITE.nombre} | Tarjetas gráficas y ordenadores para IA local`}
  description="Comparativa de tarjetas gráficas, mini PCs y Mac para IA local: VRAM, ancho de banda, modelos que caben y lo que no te cuentan. Calculadora de VRAM y comparador."
  schema={[{ '@context': 'https://schema.org', '@type': 'WebSite', name: SITE.nombre, url: SITE.url, inLanguage: SITE.idioma }, itemList(destacados), faqPage(faq)]}
>
  <header class="hero">
    <canvas id="die" aria-hidden="true"></canvas>
    <div class="wrap hero-in">
      <span class="badge badge-copper"><i class="led"></i> Hardware para IA local · España</span>
      <h1 id="h1"><span class="neon">Corre la IA</span> en tu propia máquina</h1>
      <p class="lede">Gráficas, mini PCs y Mac elegidos por lo que de verdad importa para la IA: <strong>VRAM, ancho de banda y qué modelo te cabe</strong>. Nada de FPS en juegos.</p>
      <div class="ctas">
        <a class="btn btn-copper" href="/calculadora-vram/">¿Qué modelo cabe en mi GPU?</a>
        <a class="btn" href="/comparador/">Comparar gráficas</a>
      </div>
      <div class="readouts well mono" aria-hidden="true">
        <span>SM activos <b id="r-sm">0</b></span>
        <span>Tensor <b id="r-op">0</b> TFLOPS</span>
        <span>Temp <b id="r-t">0</b> °C</span>
        <span>Tokens/s <b id="r-tok">0</b></span>
      </div>
    </div>
  </header>

  <div class="ticker mono" aria-hidden="true">
    <div>{[...productos, ...productos].map((p) => <span>{p.nombre} <em>{p.vram} GB</em> · {p.anchoBanda} GB/s</span>)}</div>
  </div>

  <main>
    <section class="block">
      <div class="wrap">
        <div class="sec-head">
          <h2>Elige por lo que<br />quieres hacer</h2>
          <p>Cada categoría ordena el hardware por el uso: chatbots locales, generar imágenes, mucha memoria en poco espacio o el presupuesto más ajustado.</p>
        </div>
        <div class="cats">
          {categorias.map((c) => (
            <a class="cat surface reveal" href={`/${c.slug}/`}>
              <span class="mono code">{codigos[c.slug] ?? 'IA'}</span>
              <h3>{c.nombre}</h3>
              <p class="muted">{c.intro.split('. ')[0]}.</p>
              <span class="cuenta mono">{productos.filter((p) => p.categorias.includes(c.slug)).length} equipos →</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="block" id="calc" style="padding-top:0">
      <div class="wrap">
        <div class="sec-head">
          <h2>Calculadora<br />de VRAM</h2>
          <p>Mueve la memoria y mira qué modelos te caben. Te decimos el equipo más ajustado que lo cumple.</p>
        </div>
        <VramCalc />
      </div>
    </section>

    <section class="block" style="padding-top:0">
      <div class="wrap">
        <div class="sec-head">
          <h2>Los más completos<br />para IA</h2>
          <p>Ordenados por lo que más pesa en IA: VRAM, ancho de banda y ecosistema de software. <a href="/como-elegimos/" style="color:var(--copper-hi)">Así puntuamos</a>.</p>
        </div>
        <div class="grid-cards">{destacados.map((p, i) => <ProductCard producto={p} pos={i + 1} />)}</div>
      </div>
    </section>

    <section class="block" style="padding-top:0">
      <div class="wrap pasos-wrap">
        <div>
          <h2>Cómo elegir en<br />cinco pasos</h2>
          <ol class="pasos">
            <li><div><b>Decide qué modelo quieres correr.</b> Un chatbot de 8B, uno de 70B o generar imágenes con Flux piden máquinas muy distintas.</div></li>
            <li><div><b>Calcula la VRAM.</b> Usa la <a href="/calculadora-vram/">calculadora</a>: en Q4, un modelo ocupa algo más de la mitad de sus miles de millones de parámetros en GB.</div></li>
            <li><div><b>Mira el ancho de banda.</b> Con la misma memoria, más GB/s es más velocidad al generar texto.</div></li>
            <li><div><b>Elige ecosistema.</b> CUDA (NVIDIA) es lo más compatible; AMD da más memoria por euro; Mac, silencio y mucha memoria.</div></li>
            <li><div><b>Revisa "lo que no".</b> Cada ficha te dice qué no hace bien: fuente necesaria, tamaño, software. Léelo antes de comprar.</div></li>
          </ol>
        </div>
        <Faq items={faq} />
      </div>
    </section>
  </main>
</Base>

<style>
  .hero { position: relative; overflow: hidden; min-height: min(86vh, 760px); display: grid; align-items: center; }
  #die { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .hero::after { content: ''; position: absolute; inset: 0; pointer-events: none; background: radial-gradient(ellipse at 22% 50%, #141414f0 0, #14141499 38%, transparent 70%), linear-gradient(0deg, var(--bg), transparent 30%); }
  .hero-in { position: relative; z-index: 2; display: grid; gap: 26px; padding-block: 88px 72px; justify-items: start; }
  .led { width: 8px; height: 8px; border-radius: 50%; background: var(--copper-hi); box-shadow: 0 0 10px var(--copper-hi); animation: parpadeo 2s ease-in-out infinite; }
  @keyframes parpadeo { 50% { opacity: 0.35; } }
  .hero h1 { font-size: clamp(48px, 9vw, 120px); line-height: 0.9; text-transform: uppercase; max-width: 11ch; letter-spacing: -0.02em; }
  .neon { color: #ffe9d8; text-shadow: 0 0 6px #ffb27a, 0 0 18px var(--copper-hi), 0 0 42px var(--copper), 0 0 80px #c9622c88; animation: zumbido 5s infinite; }
  @keyframes zumbido { 0%, 92%, 100% { opacity: 1; } 93% { opacity: 0.6; } 94% { opacity: 1; } 96% { opacity: 0.75; } }
  :global(.ch) { display: inline-block; animation: sube 0.9s cubic-bezier(0.2, 0.9, 0.2, 1) both; }
  @keyframes sube { from { transform: translateY(0.35em) skewY(6deg); filter: blur(8px); opacity: 0; } }
  .lede { max-width: 56ch; font-size: clamp(16px, 2vw, 19px); color: var(--muted); }
  .lede strong { color: var(--ink); font-weight: 600; }
  .ctas { display: flex; flex-wrap: wrap; gap: 14px; }
  .readouts { display: flex; flex-wrap: wrap; gap: 8px 26px; padding: 12px 20px; border-radius: var(--r-full); font-size: 12px; color: var(--faint); }
  .readouts b { color: var(--copper-hi); font-weight: 600; display: inline-block; min-width: 4ch; text-align: right; font-variant-numeric: tabular-nums; }

  .ticker { overflow: hidden; white-space: nowrap; font-size: 13px; color: var(--faint); padding-block: 14px; background: var(--inset); box-shadow: var(--sh-inset); mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); }
  .ticker div { display: inline-flex; gap: 44px; animation: tick 60s linear infinite; padding-left: 44px; }
  .ticker em { font-style: normal; color: var(--copper-hi); }
  @keyframes tick { to { transform: translateX(-50%); } }

  .cats { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); gap: 22px; }
  .cat { padding: 24px; text-decoration: none; display: grid; gap: 10px; align-content: start; min-height: 200px; position: relative; overflow: hidden; transition: transform 0.2s, box-shadow 0.25s; }
  .cat::before { content: ''; position: absolute; inset: 0; background: radial-gradient(360px circle at var(--mx, 50%) var(--my, 0%), #c9622c26, transparent 60%); opacity: 0; transition: opacity 0.3s; pointer-events: none; }
  .cat:hover { transform: translateY(-3px); box-shadow: var(--sh-lift), var(--edge); }
  .cat:hover::before { opacity: 1; }
  .cat .code { font-size: 11px; letter-spacing: 0.12em; color: var(--copper-hi); }
  .cat h3 { font-size: 26px; }
  .cat p { font-size: 14px; }
  .cat .cuenta { margin-top: auto; font-size: 12px; color: var(--faint); }
  .cat:hover .cuenta { color: var(--copper-hi); }

  .pasos-wrap { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: start; }
  @media (max-width: 900px) { .pasos-wrap { grid-template-columns: 1fr; } }
  .pasos { counter-reset: p; list-style: none; padding: 0; margin: 28px 0 0; display: grid; gap: 18px; }
  .pasos li { counter-increment: p; display: grid; grid-template-columns: 44px 1fr; gap: 14px; color: var(--muted); }
  .pasos li::before { content: counter(p); width: 44px; height: 44px; display: grid; place-items: center; border-radius: 50%; font: 700 16px var(--f-mono); color: #fff7f0; background: linear-gradient(160deg, var(--copper-hi), var(--copper-lo)); box-shadow: var(--sh-raised-sm), 0 0 16px var(--glow); }
  .pasos b { color: var(--ink); display: block; }
  .pasos a { color: var(--copper-hi); }
</style>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Titular: palabras que suben una a una
  const h1 = document.getElementById('h1')!;
  let k = 0;
  const split = (node: Node) => [...node.childNodes].forEach((n) => {
    if (n.nodeType === 3) {
      const frag = document.createDocumentFragment();
      n.textContent!.split(/(\s+)/).forEach((w) => {
        if (!w || /^\s+$/.test(w)) return frag.append(w);
        const s = document.createElement('span');
        s.className = 'ch'; s.style.animationDelay = `${k++ * 60}ms`; s.textContent = w; frag.append(s);
      });
      n.replaceWith(frag);
    } else split(n);
  });
  if (!reduce) split(h1);

  // Tarjetas de categoría: brillo de cobre que sigue al ratón
  document.querySelectorAll<HTMLElement>('.cat').forEach((el) => el.addEventListener('pointermove', (e) => {
    const r = el.getBoundingClientRect();
    el.style.setProperty('--mx', `${e.clientX - r.left}px`);
    el.style.setProperty('--my', `${e.clientY - r.top}px`);
  }));

  // Hero: un die de GPU vivo, en cobre neón. Se pausa fuera de pantalla.
  const cv = document.getElementById('die') as HTMLCanvasElement;
  const ctx = cv.getContext('2d')!;
  let W = 0, H = 0, cells: any[] = [], packets: any[] = [];
  const mouse = { x: -999, y: -999 }, C = 22, t0 = performance.now();
  const stops = [[20, 20, 20], [70, 34, 14], [201, 98, 44], [233, 138, 79], [255, 228, 200]];
  const heat = (v: number) => {
    v = Math.max(0, Math.min(1, v)) * (stops.length - 1);
    const i = Math.floor(v), f = v - i, a = stops[i], b = stops[Math.min(i + 1, stops.length - 1)];
    return `rgb(${(a[0] + (b[0] - a[0]) * f) | 0},${(a[1] + (b[1] - a[1]) * f) | 0},${(a[2] + (b[2] - a[2]) * f) | 0})`;
  };
  function resize() {
    const dpr = Math.min(devicePixelRatio || 1, 2), r = cv.getBoundingClientRect();
    W = r.width; H = r.height; cv.width = W * dpr; cv.height = H * dpr; ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    cells = [];
    for (let y = 0; y < Math.ceil(H / C); y++) for (let x = 0; x < Math.ceil(W / C); x++) {
      const gx = x % 9, gy = y % 7; if (gx === 8 || gy === 6) continue;
      cells.push({ x, y, v: Math.random() * 0.12, tg: 0, ph: Math.random() * 6.28, core: (gx + gy) % 3 === 0 });
    }
  }
  let visible = true, last = 0;
  function frame(now: number) {
    const t = (now - t0) / 1000;
    ctx.fillStyle = '#141414'; ctx.fillRect(0, 0, W, H);
    const wx = (Math.sin(t * 0.35) * 0.5 + 0.5) * W, wy = (Math.cos(t * 0.27) * 0.5 + 0.5) * H;
    let active = 0, sum = 0;
    for (const c of cells) {
      const px = c.x * C + C / 2, py = c.y * C + C / 2;
      let target = 0.06 + 0.05 * Math.sin(t * 2 + c.ph);
      target += Math.max(0, 1 - Math.hypot(px - wx, py - wy) / (Math.min(W, H) * 0.55)) * 0.5;
      target += Math.max(0, 1 - Math.hypot(px - mouse.x, py - mouse.y) / 170) * 0.9;
      if (Math.random() < 0.0008) c.tg = 1;
      c.tg *= 0.96; target += c.tg * 0.7; c.v += (target - c.v) * 0.08;
      if (c.v > 0.35) active++; sum += c.v;
      ctx.globalAlpha = 0.3 + c.v * 0.7; ctx.fillStyle = heat(c.v * (c.core ? 1 : 0.8));
      const s = C - 4; ctx.beginPath(); ctx.roundRect(c.x * C + 2, c.y * C + 2, s, s, 4); ctx.fill();
      if (c.core && c.v > 0.5) { ctx.globalAlpha = (c.v - 0.5) * 0.9; ctx.fillStyle = '#ffe4c8'; ctx.fillRect(px - 2, py - 2, 4, 4); }
    }
    ctx.globalAlpha = 1;
    if (Math.random() < 0.3) {
      const horiz = Math.random() < 0.6;
      const lane = horiz ? Math.floor(Math.random() * (H / C / 7)) * 7 + 6 : Math.floor(Math.random() * (W / C / 9)) * 9 + 8;
      packets.push({ horiz, lane, p: -2, s: 0.35 + Math.random() * 0.9, len: 3 + Math.random() * 8 });
    }
    ctx.lineCap = 'round'; ctx.shadowColor = '#e98a4f'; ctx.shadowBlur = 12;
    packets = packets.filter((p) => {
      p.p += p.s; if (p.p - p.len > (p.horiz ? W : H) / C) return false;
      const a = (p.p - p.len) * C, b = p.p * C, l = p.lane * C + C / 2;
      const g = p.horiz ? ctx.createLinearGradient(a, 0, b, 0) : ctx.createLinearGradient(0, a, 0, b);
      g.addColorStop(0, 'rgba(201,98,44,0)'); g.addColorStop(0.7, 'rgba(233,138,79,.85)'); g.addColorStop(1, '#ffe4c8');
      ctx.strokeStyle = g; ctx.lineWidth = 2; ctx.beginPath();
      if (p.horiz) { ctx.moveTo(a, l); ctx.lineTo(b, l); } else { ctx.moveTo(l, a); ctx.lineTo(l, b); }
      ctx.stroke(); return true;
    });
    ctx.shadowBlur = 0;
    if (now - last > 120 && cells.length) {
      last = now; const avg = sum / cells.length;
      document.getElementById('r-sm')!.textContent = String(Math.min(170, Math.round((active / cells.length) * 170 * 2.2)));
      document.getElementById('r-op')!.textContent = (avg * 1650).toFixed(0);
      document.getElementById('r-t')!.textContent = (38 + avg * 60).toFixed(0);
      document.getElementById('r-tok')!.textContent = (avg * 420).toFixed(0);
    }
    if (!reduce && visible) requestAnimationFrame(frame);
  }
  addEventListener('resize', resize);
  const hero = cv.parentElement!;
  hero.addEventListener('pointermove', (e) => { const r = cv.getBoundingClientRect(); mouse.x = e.clientX - r.left; mouse.y = e.clientY - r.top; });
  hero.addEventListener('pointerleave', () => { mouse.x = mouse.y = -999; });
  new IntersectionObserver(([e]) => {
    const was = visible; visible = e.isIntersecting;
    if (visible && !was && !reduce) requestAnimationFrame(frame);
  }).observe(hero);
  resize(); requestAnimationFrame(frame);
</script>
